#: htdocs/luci-static/resources/view/status/include/25_yandex_speedtest.js:365
msgid "Click to run again"
msgstr "Нажмите, чтобы повторить"

#: htdocs/luci-static/resources/view/status/include/25_yandex_speedtest.js:158
msgid "Click to show IP"
msgstr "Нажмите, чтобы показать IP"


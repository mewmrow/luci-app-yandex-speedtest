msgid "Click to start the test"
msgstr "Нажмите, чтобы начать тест"

#: htdocs/luci-static/resources/view/status/include/25_yandex_speedtest.js:114
msgid "curl is required: apk add curl / opkg install curl"
msgstr "Нужен curl: apk add curl / opkg install curl"

#: htdocs/luci-static/resources/view/yandex-speedtest/settings.js:10
msgid "Expecting a http:// or https:// URL"
msgstr "Ожидается URL вида http:// или https://"

#: htdocs/luci-static/resources/view/yandex-speedtest/settings.js:37
msgid "Fallback download URL"
msgstr "Запасной URL для загрузки"

#: htdocs/luci-static/resources/view/yandex-speedtest/settings.js:42
msgid "Fallback upload URL"
msgstr "Запасной URL для отдачи"

#: root/usr/share/rpcd/acl.d/luci-app-yandex-speedtest.json:3
msgid "Grant access to the Yandex speed test"
msgstr "Предоставить доступ к тесту скорости Яндекса"

#: htdocs/luci-static/resources/view/yandex-speedtest/settings.js:32
msgid "Interface"
msgstr "Интерфейс"

#: htdocs/luci-static/resources/view/status/include/25_yandex_speedtest.js:307
#, c-format
msgid "latency %d ms"
msgstr "задержка %d мс"

#: htdocs/luci-static/resources/view/status/include/25_yandex_speedtest.js:186
msgid "Mbps"
msgstr "Мбит/с"

#: htdocs/luci-static/resources/view/yandex-speedtest/settings.js:28
msgid "Parallel connections in each phase, 1 to 8."
msgstr "Параллельных соединений в каждой фазе, от 1 до 8."

#: htdocs/luci-static/resources/view/yandex-speedtest/settings.js:22
msgid "Phase duration"
msgstr "Длительность фазы"

#: htdocs/luci-static/resources/view/status/include/25_yandex_speedtest.js:361
msgid "Preparing…"
msgstr "Подготовка…"

#: htdocs/luci-static/resources/view/yandex-speedtest/settings.js:33
msgid "Run the test through this interface. Unspecified: use the default route."
msgstr "Через какой интерфейс идёт тест. Не указан — по маршруту по умолчанию."

#: htdocs/luci-static/resources/view/yandex-speedtest/settings.js:23
msgid "Seconds for the download and for the upload phase, 5 to 60."
msgstr "Секунд на загрузку и столько же на отдачу, от 5 до 60."

#: htdocs/luci-static/resources/view/status/include/25_yandex_speedtest.js:123
msgid "Speed test"
msgstr "Тест скорости"

#: htdocs/luci-static/resources/view/status/include/25_yandex_speedtest.js:216 htdocs/luci-static/resources/view/status/include/25_yandex_speedtest.js:359
msgid "Stopping…"
msgstr "Остановка…"

#: htdocs/luci-static/resources/view/yandex-speedtest/settings.js:27
msgid "Streams"
msgstr "Потоки"

#: htdocs/luci-static/resources/view/status/include/25_yandex_speedtest.js:363
msgid "Testing, click to stop"
msgstr "Идёт тест, нажмите, чтобы остановить"

#: htdocs/luci-static/resources/view/yandex-speedtest/settings.js:18
msgid "The test card is on Status → Overview. Changes apply to the next test."
msgstr "Карточка теста — на странице Состояние → Обзор. Изменения применяются со следующего теста."

#: htdocs/luci-static/resources/view/status/include/25_yandex_speedtest.js:118
msgid "The test failed"
msgstr "Тест не удался"

#: htdocs/luci-static/resources/view/status/include/25_yandex_speedtest.js:116
msgid "The test was interrupted"
msgstr "Тест прерван"

#: htdocs/luci-static/resources/view/yandex-speedtest/settings.js:38
msgid "Used when the Yandex API is unavailable. A large file, at least a few hundred megabytes."
msgstr "Используется, если API Яндекса недоступен. Большой файл, хотя бы несколько сотен мегабайт."

#: htdocs/luci-static/resources/view/yandex-speedtest/settings.js:43
msgid "Used when the Yandex API is unavailable. Accepts POST requests of any size."
msgstr "Используется, если API Яндекса недоступен. Должен принимать POST любого размера."

